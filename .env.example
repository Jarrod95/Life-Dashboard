FLASK_SECRET_KEY=replace-with-a-long-random-local-secret
LIFE_FINANCE_XLSX_PATH=
LIFE_DATABASE_PATH=data/life-dashboard.sqlite
LIFE_MAX_UPLOAD_MB=20
LIFE_PORT=5050

# Gym Day ZIP folder (local, do not commit actual archive exports)
LIFE_GYMDAY_EXPORT_DIR=
LIFE_GYMDAY_IMPORT_ON_STARTUP=false

# Local sandbox-scripts MyFitnessPal CSV directory (optional; auto-detected under OneDrive/Documents/Codebases)
LIFE_MFP_DATA_DIR=

# MyFitnessPal daily nutrition targets (shown as dashed reference lines)
MFP_CALORIE_GOAL=1800
MFP_CARB_GOAL=73
MFP_FAT_GOAL=60
MFP_PROTEIN_GOAL=203

# Body composition workbook (read-only)
LIFE_BODY_COMPOSITION_XLSX_PATH=
LIFE_BODY_COMPOSITION_IMPORT_ON_STARTUP=true
BODY_WEIGHT_GOAL_KG=84
BODY_FAT_GOAL_PCT=8

# Microsoft personal OneDrive (delegated OAuth; no client secret)
LIFE_DATA_SOURCE=local
MS_GRAPH_CLIENT_ID=
MS_GRAPH_AUTHORITY=https://login.microsoftonline.com/consumers
MS_GRAPH_SCOPES=User.Read Files.Read offline_access
LIFE_FINANCE_ONEDRIVE_PATH=Documents/Finance & Work/Tracking Spreadsheets/Financial Dashboard.xlsx
LIFE_BODY_COMPOSITION_ONEDRIVE_PATH=Documents/Fitness & Health/Body Composition.xlsx
LIFE_GYMDAY_ONEDRIVE_DIR=Documents/Codebases/sandbox-scripts/fitness_health/gymday/data
LIFE_MFP_ONEDRIVE_DIR=Documents/Codebases/sandbox-scripts/fitness_health/myfitnesspal/data
LIFE_SYNC_INTERVAL_MINUTES=60
LIFE_SYNC_ON_STARTUP=true
LIFE_SYNC_LOCAL_FALLBACK=true
# Protect remote actions when accessed over HTTP; only loopback clients permitted.
